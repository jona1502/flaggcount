# Umgebung des Web-Containers (Next.js). Keine Backend-Secrets: Stripe-Keys, Datenbank, Signierschluessel und
# Dashboard-Passwort gehoeren ausschliesslich in .env des Server-Containers.

# Backend im privaten Netz (in docker-compose.yml bereits gesetzt)
BACKEND_INTERNAL_URL=http://server:3010

# Optional: Anmeldelink des Stripe-Kundenportals fuer /abo-verwalten,
# z. B. https://billing.stripe.com/p/login/... (Stripe-Dashboard -> Kundenportal -> Link zum Kundenportal)
STRIPE_PORTAL_LOGIN_URL=

# --- Admin-Bereich unter /admin ---
# GitHub OAuth App mit der Callback-URL https://<domain>/admin/auth/callback
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=
# Numerische GitHub-Konto-IDs mit Zugriff, kommagetrennt; dieselben IDs auch in .env des Servers eintragen
ADMIN_GITHUB_USER_IDS=
# Oeffentliche Adresse fuer die Callback-URL, z. B. https://overlay.muhrindustries.com
PUBLIC_BASE_URL=
# Dasselbe Geheimnis wie in .env des Servers; damit signiert die Website jede Admin-Anfrage an das Backend
ADMIN_ASSERTION_SECRET=

# Zur Build-Zeit: oeffentliche Adresse fuer Canonical-URLs und Sitemap, Suchmaschinen erst nach Rechtspruefung zulassen
# SITE_URL=https://overlay.muhrindustries.com
# SITE_INDEXING=false
