{
  "name": "flagcount",
  "version": "0.1.0",
  "private": true,
  "description": "Zählt rote Flaggen im TikTok-Live-Chat",
  "author": "jona1502",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p sidecar/tsconfig.json && tsc --noEmit -p shared/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tiktok-live-connector": "^2.4.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "~5.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
