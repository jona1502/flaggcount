{
  "name": "audience-live",
  "version": "0.9.1",
  "private": true,
  "description": "Live-Zuschauerinteraktion und Counter für Streams",
  "author": "jona1502",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:sidecar:windows": "node scripts/build-sidecar.mjs --target x86_64-pc-windows-msvc",
    "build:sidecar:macos": "node scripts/build-sidecar.mjs --target aarch64-apple-darwin",
    "build:sidecar:linux": "node scripts/build-sidecar.mjs --target x86_64-unknown-linux-gnu",
    "build:web": "npm run build -w @flagcount/web && node scripts/check-client-bundle.mjs apps/web/.next/static",
    "dev:next": "npm run dev -w @flagcount/web",
    "dev:proxy": "node scripts/dev-proxy.mjs",
    "build:next": "npm run build:web",
    "lint": "npm run lint -w @flagcount/web",
    "build:server": "esbuild sidecar/src/web/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=server-dist/server.cjs --log-level=warning",
    "start:web": "node server-dist/server.cjs",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs",
    "package:windows": "tauri build --bundles nsis",
    "package:macos": "tauri build --bundles dmg",
    "package:linux": "tauri build --bundles appimage,deb",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p sidecar/tsconfig.json && tsc --noEmit -p sidecar/tsconfig.browser.json && tsc --noEmit -p shared/tsconfig.json && npm run typecheck -w @flagcount/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tiktok-live-connector": "^2.4.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "~5.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
