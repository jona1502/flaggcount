# Passwort fuer das Dashboard (Login-Seite, mindestens 12 Zeichen).
# Aendern meldet alle angemeldeten Browser ab.
# Erzeugen: openssl rand -hex 20
DASHBOARD_PASSWORD=

# Optional: Euler-Stream-API-Key fuer den TikTok-Sign-Server (hoeheres Rate-Limit).
TIKTOK_SIGN_API_KEY=

# --- FlagCount Pro: Lizenzdienst und Billing (optional) ---
# Ohne diese Variablen laeuft der Server wie bisher; /api/v1 antwortet dann mit 503.
# Test und Live strikt trennen: eigene Datenbank, eigene Keys, eigene Preise.
# Datenbank, z. B. lokal: npm run dev:db
DATABASE_URL=
# Signaturschluessel erzeugen: node scripts/generate-license-keys.mjs 2026-09
LICENSE_SIGNING_KEY_ID=
LICENSE_SIGNING_PRIVATE_KEY=
# Geheimer Zusatz fuer die Hashes der Aktivierungscodes (mindestens 32 Zeichen). Nie aendern,
# sonst sind alle ausgegebenen Codes ungueltig. Erzeugen: openssl rand -hex 32
LICENSE_CODE_PEPPER=
# Supportadresse in E-Mails an Kunden
SUPPORT_EMAIL=
# Oeffentliche Adresse der Website fuer Checkout- und Portal-Ruecksprung, z. B. https://overlay.example.com
PUBLIC_BASE_URL=

# --- Stripe (siehe docs/FLAGCOUNT_PRO_STRIPE.md) ---
# Secret oder Restricted Key; sk_test_/rk_test_ = Test Mode, sk_live_/rk_live_ = Live Mode
STRIPE_SECRET_KEY=
# Signing Secret des Endpoints https://<domain>/api/v1/billing/webhooks/stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Stripe-Preis-IDs (price_...)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_FOUNDING=
# Optional: Konfiguration des Kundenportals (bpc_...), sonst die Standardkonfiguration
STRIPE_PORTAL_CONFIGURATION_ID=
# true: Stripe ist Merchant of Record (Managed Payments); false: Stripe Tax, Steuerpflichten bei dir
STRIPE_MANAGED_PAYMENTS_ENABLED=

# --- Paddle (veraltet, nur bis zur Umstellung auf Stripe; nicht zusammen mit STRIPE_ setzen) ---
# sandbox oder production; der API-Key muss dazu passen (pdl_sdbx_... bzw. pdl_live_...)
PADDLE_ENVIRONMENT=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
PADDLE_PRICE_FOUNDING=
PADDLE_CHECKOUT_URL=

# E-Mail-Versand fuer Aktivierungscodes, z. B. smtps://user:passwort@smtp.example.com:465
SMTP_URL=
MAIL_FROM=
# Nur mit Test-Keys: Mails in eine Datei schreiben statt senden (enthaelt Aktivierungscodes!)
MAIL_OUTBOX_FILE=

# --- Admin-Bereich unter /admin (optional, braucht den Lizenzdienst) ---
# GitHub OAuth App: Callback-URL https://<domain>/admin/auth/callback
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=
# Numerische GitHub-Konto-IDs mit Zugriff, kommagetrennt (https://api.github.com/users/<name> -> "id")
ADMIN_GITHUB_USER_IDS=
# Gemeinsames Geheimnis mit dem Web-Container (.env.web), der Admin-Anfragen signiert (mindestens 32 Zeichen).
# Ohne gueltigen, signierten Nachweis lehnt das Backend jede Admin-Anfrage ab. Erzeugen: openssl rand -hex 32
ADMIN_ASSERTION_SECRET=
