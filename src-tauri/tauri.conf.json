{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlagCount",
  "version": "0.3.2",
  "identifier": "com.jona1502.flagcount",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sidecar && npm run build",
    "frontendDist": "../dist",
    "additionalWatchFolders": ["../sidecar/src", "../shared"]
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FlagCount",
        "width": 960,
        "height": 820,
        "minWidth": 640,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src http://127.0.0.1:*",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwNEYxRkM1OThDODA1OTQKUldTVUJjaVl4UjlQb0xKRFJsU1grZVR4Qzh4ekJvZ0pJSTFHbVgwMFQ5VWxQVTVOcEhBbFl5VHIK",
      "endpoints": [
        "https://github.com/jona1502/flaggcount/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "jona1502",
    "copyright": "© 2026 jona1502",
    "category": "Utility",
    "shortDescription": "Zählt rote Flaggen im TikTok-Live-Chat",
    "longDescription": "FlagCount zählt rote Flaggen im TikTok-Live-Chat mit einer Stimme pro Zuschauer je Runde und zeigt das Ergebnis im Dashboard und als Streaming-Overlay.",
    "externalBin": ["binaries/flagcount-sidecar"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
