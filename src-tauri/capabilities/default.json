{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimale Rechte für das Hauptfenster",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "clipboard-manager:allow-write-text",
    "updater:default",
    "allow-get-state",
    "allow-connect",
    "allow-disconnect",
    "allow-add-manual-vote",
    "allow-remove-manual-vote",
    "allow-reset-votes",
    "allow-set-target",
    "allow-set-overlay-settings",
    "allow-set-counter-overlay-settings",
    "allow-import-overlay-asset",
    "allow-clear-history",
    "allow-export-history-csv",
    "allow-create-profile",
    "allow-duplicate-profile",
    "allow-rename-profile",
    "allow-delete-profile",
    "allow-switch-profile",
    "allow-save-counters",
    "allow-activate-license",
    "allow-refresh-license",
    "allow-deactivate-license",
    "allow-open-customer-portal",
    "allow-open-pro-page"
  ]
}
